{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --list-different .",
    "prepare": "husky",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/icon": "2.6.0",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/ui": "4.12.0",
    "@pinia/nuxt": "1.0.3",
    "@prometheus-io/client": "0.16.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "nuxt": "4.6.2",
    "pinia": "4.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "valibot": "1.5.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@types/node": "26.6.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "tailwindcss": "4.3.3",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "pnpm@12.15.0",
  "lint-staged": {
    "*.{js,mjs,ts,vue}": "pnpm lint:fix",
    "*.{md,json,css,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
